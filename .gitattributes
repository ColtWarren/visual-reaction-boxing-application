# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Force LF for source files (cross-platform consistency)
*.java text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.scss text eol=lf

# Force CRLF for Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat as binary (no diff/merge)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.zip  binary
*.jar  binary
*.war  binary
*.woff binary
*.woff2 binary
*.ttf  binary
